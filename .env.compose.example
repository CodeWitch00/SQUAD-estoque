# Modelo de variáveis locais do Compose.
#
# Copie para .env.compose e ajuste apenas no seu computador:
#   cp .env.compose.example .env.compose       (Ubuntu/macOS)
#   copy .env.compose.example .env.compose     (Windows PowerShell)
#
# .env.compose é ignorado pelo Git. Nunca versione senhas, chaves ou tokens.
# Todas as linhas abaixo são apenas exemplos comentados.

# Permite sobrescrever os hosts aceitos pela aplicação em Production.
# AllowedHosts=localhost;127.0.0.1;[::1]

# Caminhos devem permanecer dentro do volume montado em /app/data.
# DataProtection__KeysPath=/app/data/keys
# ConnectionStrings__EstoqueContext=Data Source=/app/data/Estoque.db

# Usuários demonstrativos são uma opção de Development. Em Production,
# use apenas em demonstração controlada com banco novo.
# Demo__SeedUsers=false
