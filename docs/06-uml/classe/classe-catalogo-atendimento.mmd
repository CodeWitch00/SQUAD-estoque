---
config:
  theme: neutral
  class:
    nodeSpacing: 18
    rankSpacing: 24
    padding: 7
    dividerMargin: 3
    diagramPadding: 4
    hideEmptyMembersBox: true
---
classDiagram
    class Usuario {
        +Guid Id
        +string Email
        +PerfilUsuario Perfil
    }
    class Produto {
        +Guid Id
        +string Nome
        +bool Ativo
        +ICollection~Sku~ Skus
    }
    class Sku {
        +Guid Id
        +string Numeracao
        +int SaldoAtual
        +ICollection~Movimentacao~ Movimentacoes
        +ICollection~Ruptura~ Rupturas
    }
    class Movimentacao {
        +Guid Id
        +TipoMovimentacao Tipo
        +int Quantidade
        +DateTime CriadoEm
        +string? Motivo
    }
    class Ruptura {
        +Guid Id
        +DateTime CriadoEm
    }
    class Atendimento {
        +Guid Id
        +StatusAtendimento Status
        +ResultadoAtendimento? Resultado
        +int? SaldoConsultado
        +DateTime CriadoEm
        +DateTime? ConcluidoEm
    }

    Produto "1" -- "0..*" Sku : possui
    Usuario "1" -- "0..*" Atendimento : conduz
    Usuario "1" -- "0..*" Movimentacao : registra
    Usuario "1" -- "0..*" Ruptura : registra
    Produto "1" -- "0..*" Atendimento : consultado
    Sku "0..1" -- "0..*" Atendimento : selecionado
    Sku "1" -- "0..*" Movimentacao : historico
    Sku "1" -- "0..*" Ruptura : demanda
    Atendimento "0..1" -- "0..1" Movimentacao : venda
    Atendimento "0..1" -- "0..1" Ruptura : nao_tinha
