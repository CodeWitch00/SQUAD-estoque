      CREATE TABLE "Atendimento" (&#xD;
          "Id" TEXT NOT NULL CONSTRAINT "PK_Atendimento" PRIMARY KEY,&#xD;
          "UsuarioId" TEXT NOT NULL,&#xD;
          "ProdutoId" TEXT NOT NULL,&#xD;
          "SkuId" TEXT NULL,&#xD;
          "Status" INTEGER NOT NULL,&#xD;
          "Resultado" INTEGER NULL,&#xD;
          "SaldoConsultado" INTEGER NULL,&#xD;
          "CriadoEm" TEXT NOT NULL,&#xD;
          "ConcluidoEm" TEXT NULL,&#xD;
          CONSTRAINT "chk_atendimento_conclusao" CHECK ((Status = 0 AND Resultado IS NULL AND ConcluidoEm IS NULL) OR (Status = 1 AND Resultado IS NOT NULL AND ConcluidoEm IS NOT NULL)),&#xD;
          CONSTRAINT "chk_atendimento_resultado" CHECK (Resultado IS NULL OR Resultado IN (0, 1, 2)),&#xD;
          CONSTRAINT "chk_atendimento_saldo" CHECK (SaldoConsultado IS NULL OR SaldoConsultado &gt;= 0),&#xD;
          CONSTRAINT "chk_atendimento_sku_resultado" CHECK (Resultado IS NULL OR Resultado = 2 OR SkuId IS NOT NULL),&#xD;
          CONSTRAINT "chk_atendimento_status" CHECK (Status IN (0, 1)),&#xD;
          CONSTRAINT "FK_Atendimento_Produto_ProdutoId" FOREIGN KEY ("ProdutoId") REFERENCES "Produto" ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_Atendimento_Sku_SkuId" FOREIGN KEY ("SkuId") REFERENCES "Sku" ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_Atendimento_Usuario_UsuarioId" FOREIGN KEY ("UsuarioId") REFERENCES "Usuario" ("Id") ON DELETE RESTRICT&#xD;
      );&#xD;
