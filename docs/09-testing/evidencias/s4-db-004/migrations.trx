      SELECT "p"."Id", "p"."Nome", "p"."Marca", "p"."Cor", "s1"."Id", "s1"."Numeracao", "s1"."SaldoAtual", "s1"."UltimaAtualizacaoSaldoEm"&#xD;
      FROM "Produto" AS "p"&#xD;
      LEFT JOIN (&#xD;
          SELECT "s0"."Id", "s0"."Numeracao", "s0"."SaldoAtual", "s0"."UltimaAtualizacaoSaldoEm", "s0"."ProdutoId"&#xD;
          FROM "Sku" AS "s0"&#xD;
          WHERE "s0"."Ativo" AND "s0"."SaldoAtual" = 0&#xD;
      ) AS "s1" ON "p"."Id" = "s1"."ProdutoId"&#xD;
      WHERE "p"."Ativo" AND EXISTS (&#xD;
          SELECT 1&#xD;
          FROM "Sku" AS "s"&#xD;
          WHERE "p"."Id" = "s"."ProdutoId" AND "s"."Ativo" AND "s"."SaldoAtual" = 0)&#xD;
      ORDER BY "p"."Id"&#xD;
