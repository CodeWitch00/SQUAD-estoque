          CONSTRAINT "chk_atendimento_conclusao" CHECK ((Status = 0 AND Resultado IS NULL AND ConcluidoEm IS NULL) OR (Status = 1 AND Resultado IS NOT NULL AND ConcluidoEm IS NOT NULL)),&#xD;
          CONSTRAINT "chk_atendimento_resultado" CHECK (Resultado IS NULL OR Resultado IN (0, 1, 2)),&#xD;
