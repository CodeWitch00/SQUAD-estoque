      SELECT "p"."Nome" AS "Produto", "p"."Marca", "p"."Cor", "s"."Numeracao", COUNT(*) AS "QuantidadeOcorrencias", MAX("r"."CriadoEm") AS "UltimaOcorrencia"&#xD;
      FROM "Ruptura" AS "r"&#xD;
      INNER JOIN "Sku" AS "s" ON "r"."SkuId" = "s"."Id"&#xD;
      INNER JOIN "Produto" AS "p" ON "s"."ProdutoId" = "p"."Id"&#xD;
      GROUP BY "r"."SkuId", "p"."Nome", "p"."Marca", "p"."Cor", "s"."Numeracao"&#xD;
      ORDER BY COUNT(*) DESC, MAX("r"."CriadoEm") DESC, "p"."Nome", "p"."Marca", "p"."Cor", "s"."Numeracao"&#xD;
