    <UnitTestResult executionId="dae0d253-70c4-4f4d-beb7-f124fd86d0c5" testId="437a18a2-dee5-4084-3714-27c6952c7866" testName="SquadEstoque.Web.Tests.ConsultaQueryPerformanceTests.Resume_preserves_grade_with_constant_query_count(skuCount: 4)" computerName="NOTEBOOKNICK" duration="00:00:00.2653650" startTime="2026-11-18T20:11:00.3040348-03:00" endTime="2026-11-18T20:11:00.5694744-03:00" testType="13cdc9d9-ddb5-4fa4-a97d-d965ccfc6d4b" outcome="Passed" testListId="8c84fa94-04c1-424b-9868-57a2d4851a1d" relativeResultsDirectory="dae0d253-70c4-4f4d-beb7-f124fd86d0c5">
      <Output>
        <StdOut>SKUs=4; active=2; queries=2; median_ms=1,725; median_bytes=70920; iterations=30; warmup=5&#xD;
SELECT "s0"."Id", "s0"."SkuId", "s0"."c", "s0"."Id0", "s0"."Nome", "s0"."Marca", "s0"."Categoria", "s0"."Cor", "s0"."ImagemUrl", "s1"."Id", "s1"."Numeracao", "s1"."SaldoAtual", "s1"."UltimaAtualizacaoSaldoEm"&#xD;
FROM (&#xD;
    SELECT "a"."Id", "a"."SkuId", 0 AS "c", "p"."Id" AS "Id0", "p"."Nome", "p"."Marca", "p"."Categoria", "p"."Cor", "p"."ImagemUrl"&#xD;
    FROM "Atendimento" AS "a"&#xD;
    INNER JOIN "Produto" AS "p" ON "a"."ProdutoId" = "p"."Id"&#xD;
    WHERE "a"."Id" = @atendimentoId_Value AND "a"."UsuarioId" = @usuarioId_Value AND "a"."Status" = 0&#xD;
    LIMIT 1&#xD;
) AS "s0"&#xD;
LEFT JOIN (&#xD;
    SELECT "s"."Id", "s"."Numeracao", "s"."SaldoAtual", "s"."UltimaAtualizacaoSaldoEm", "s"."ProdutoId"&#xD;
    FROM "Sku" AS "s"&#xD;
    WHERE "s"."Ativo"&#xD;
) AS "s1" ON "s0"."Id0" = "s1"."ProdutoId"&#xD;
ORDER BY "s0"."Id", "s0"."Id0", "s1"."Numeracao"</StdOut>
      </Output>
    </UnitTestResult>
