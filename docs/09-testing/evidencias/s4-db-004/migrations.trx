      SELECT "a"."Id", "p"."Nome" AS "ProdutoNome", "p"."Marca" || ' � ' || "p"."Cor" AS "ProdutoDetalhes", "p"."ImagemUrl", "s"."Numeracao", "a"."CriadoEm"&#xD;
      FROM "Atendimento" AS "a"&#xD;
      INNER JOIN "Produto" AS "p" ON "a"."ProdutoId" = "p"."Id"&#xD;
      LEFT JOIN "Sku" AS "s" ON "a"."SkuId" = "s"."Id"&#xD;
      WHERE "a"."UsuarioId" = @usuarioId AND "a"."Status" = 0&#xD;
      ORDER BY "a"."CriadoEm" DESC&#xD;
