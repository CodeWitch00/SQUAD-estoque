    <UnitTestResult executionId="8cd1a2a7-337c-4686-a5b4-9eb4f1b82888" testId="14f7b67f-eb99-02c4-df3a-03ef33ea595a" testName="SquadEstoque.Web.Tests.ConsultaQueryPerformanceTests.Resume_preserves_grade_with_constant_query_count(skuCount: 200)" computerName="NOTEBOOKNICK" duration="00:00:00.4508262" startTime="2026-11-18T20:11:00.5696751-03:00" endTime="2026-11-18T20:11:01.0204298-03:00" testType="13cdc9d9-ddb5-4fa4-a97d-d965ccfc6d4b" outcome="Passed" testListId="8c84fa94-04c1-424b-9868-57a2d4851a1d" relativeResultsDirectory="8cd1a2a7-337c-4686-a5b4-9eb4f1b82888">
      <Output>
        <StdOut>SKUs=200; active=100; queries=2; median_ms=5,918; median_bytes=427576; iterations=30; warmup=5&#xD;
SELECT "s0"."Id", "s0"."SkuId", "s0"."c", "s0"."Id0", "s0"."Nome", "s0"."Marca", "s0"."Categoria", "s0"."Cor", "s0"."ImagemUrl", "s1"."Id", "s1"."Numeracao", "s1"."SaldoAtual", "s1"."UltimaAtualizacaoSaldoEm"&#xD;
FROM (&#xD;
    SELECT "a"."Id", "a"."SkuId", 0 AS "c", "p"."Id" AS "Id0", "p"."Nome", "p"."Marca", "p"."Categoria", "p"."Cor", "p"."ImagemUrl"&#xD;
    FROM "Atendimento" AS "a"&#xD;
    INNER JOIN "Produto" AS "p" ON "a"."ProdutoId" = "p"."Id"&#xD;
    WHERE "a"."Id" = @atendimentoId_Value AND "a"."UsuarioId" = @usuarioId_Value AND "a"."Status" = 0&#xD;
    LIMIT 1&#xD;
) AS "s0"&#xD;
LEFT JOIN (&#xD;
    SELECT "s"."Id", "s"."Numeracao", "s"."SaldoAtual", "s"."UltimaAtualizacaoSaldoEm", "s"."ProdutoId"&#xD;
    FROM "Sku" AS "s"&#xD;
    WHERE "s"."Ativo"&#xD;
) AS "s1" ON "s0"."Id0" = "s1"."ProdutoId"&#xD;
ORDER BY "s0"."Id", "s0"."Id0", "s1"."Numeracao"</StdOut>
      </Output>
    </UnitTestResult>
