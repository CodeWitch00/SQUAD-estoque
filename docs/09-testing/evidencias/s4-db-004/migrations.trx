      SELECT "p0"."Id", "p0"."Ativo", "p0"."Categoria", "p0"."Cor", "p0"."ImagemUrl", "p0"."Marca", "p0"."Nome", "s"."Id", "s"."Ativo", "s"."Numeracao", "s"."ProdutoId", "s"."SaldoAtual", "s"."UltimaAtualizacaoSaldoEm"&#xD;
      FROM (&#xD;
          SELECT "p"."Id", "p"."Ativo", "p"."Categoria", "p"."Cor", "p"."ImagemUrl", "p"."Marca", "p"."Nome"&#xD;
          FROM "Produto" AS "p"&#xD;
          WHERE "p"."Id" = 'AAAAAAAA-AAAA-AAAA-AAAA-AAAAAAAAAAAA'&#xD;
          LIMIT 2&#xD;
      ) AS "p0"&#xD;
      LEFT JOIN "Sku" AS "s" ON "p0"."Id" = "s"."ProdutoId"&#xD;
      ORDER BY "p0"."Id"&#xD;
