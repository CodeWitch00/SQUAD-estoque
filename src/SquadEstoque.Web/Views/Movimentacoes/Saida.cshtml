@model SquadEstoque.Web.Models.MovimentacaoCreateViewModel

@{
    ViewData["Title"] = "Registrar Saída de Estoque";
}

<header class="admin-page-heading admin-form-heading movement-form-heading">
    <div>
        <h1>Registrar saída de estoque</h1>
        <p class="admin-page-intro">Selecione a numeração e informe quantos pares saíram da loja.</p>
    </div>
</header>

<div class="movement-form-layout">
    <section class="movement-form-surface" aria-label="Formulário de saída de estoque">
        <form asp-action="Saida" method="post" class="movement-form">
                    <input type="hidden" asp-for="Tipo" />
                    <div asp-validation-summary="ModelOnly" class="movement-validation-summary" role="alert"></div>

                    @if (Model.SkuId != Guid.Empty && !string.IsNullOrEmpty(Model.ProdutoNome))
                    {
                        <input type="hidden" asp-for="SkuId" />
                        <div class="movement-context movement-context--outgoing">
                            <p class="movement-context-label">Item selecionado</p>
                            <p class="movement-context-product">@Model.ProdutoNome</p>
                            <div class="movement-context-details">
                                <span><strong>Numeração</strong> <span class="movement-size-chip">@Model.Numeracao</span></span>
                                <span class="movement-context-balance"><strong>Saldo atual</strong> @Model.SaldoAtual par(es)</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="movement-field">
                            <label asp-for="SkuId" class="form-label">Selecione o Produto e Numeração</label>
                            <select asp-for="SkuId" asp-items="ViewBag.SkusList" class="form-select movement-select" autofocus>
                                <option value="">-- Selecione o item --</option>
                            </select>
                            <span asp-validation-for="SkuId" class="movement-validation"></span>
                        </div>
                    }

                    <div class="movement-field">
                        <label asp-for="Quantidade" class="form-label">Quantidade a Retirar (Pares)</label>
                        <input asp-for="Quantidade" type="number" min="1" class="form-control movement-input movement-input--quantity" />
                        <span asp-validation-for="Quantidade" class="movement-validation"></span>
                    </div>

                    <div class="movement-field movement-field--last">
                        <label asp-for="Motivo" class="form-label">Observação / Motivo (Opcional)</label>
                        <input asp-for="Motivo" class="form-control movement-input" placeholder="ex: Venda balcão / Transferência" />
                        <span asp-validation-for="Motivo" class="movement-validation"></span>
                    </div>

                    <div class="movement-form-actions">
                        @if (User.IsInRole("LOJISTA"))
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        }
                        else
                        {
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        }
                        <button type="submit" class="btn btn-primary">Confirmar saída</button>
                    </div>
                </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
