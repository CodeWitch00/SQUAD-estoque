@model SquadEstoque.Web.Models.MovimentacaoCreateViewModel

@{
    ViewData["Title"] = "Registrar Entrada de Estoque";
}

<header class="admin-page-heading admin-form-heading mb-4">
    <div>
        <h1>Registrar entrada de estoque</h1>
        <p class="admin-page-intro">Selecione a numeração e informe quantos pares entraram na loja.</p>
    </div>
</header>

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-9 col-xl-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Entrada" method="post">
                    <input type="hidden" asp-for="Tipo" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    @if (Model.SkuId != Guid.Empty && !string.IsNullOrEmpty(Model.ProdutoNome))
                    {
                        <input type="hidden" asp-for="SkuId" />
                        <div class="alert alert-light border mb-3">
                            <div><strong>Modelo:</strong> @Model.ProdutoNome</div>
                            <div><strong>Numeração:</strong> <span class="badge bg-secondary">@Model.Numeracao</span></div>
                            <div class="mt-1"><strong>Saldo Atual em Loja:</strong> <span class="fw-bold">@Model.SaldoAtual par(es)</span></div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label asp-for="SkuId" class="form-label">Selecione o Produto e Numeração</label>
                            <select asp-for="SkuId" asp-items="ViewBag.SkusList" class="form-select" autofocus>
                                <option value="">-- Selecione o item --</option>
                            </select>
                            <span asp-validation-for="SkuId" class="text-danger small"></span>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="Quantidade" class="form-label">Quantidade Recebida (Pares)</label>
                        <input asp-for="Quantidade" type="number" min="1" class="form-control form-control-lg" />
                        <span asp-validation-for="Quantidade" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Motivo" class="form-label">Observação / Nota (Opcional)</label>
                        <input asp-for="Motivo" class="form-control" placeholder="ex: Nota Fiscal 1234 / Recebimento de fábrica" />
                        <span asp-validation-for="Motivo" class="text-danger small"></span>
                    </div>

                    <div class="admin-form-actions">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Confirmar entrada</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
