@model IEnumerable<SquadEstoque.Web.Models.Movimentacao>

@{
    ViewData["Title"] = "Histórico de Movimentações";
}

<div class="admin-page-heading mb-4">
    <div>
        <h1>Histórico de Movimentações</h1>
        <p class="admin-page-intro">Acompanhe entradas, saídas e ajustes registrados no estoque.</p>
    </div>
    <div class="admin-page-actions">
        <a asp-action="Entrada" class="btn btn-primary">Nova entrada</a>
        <a asp-action="Saida" class="btn btn-outline-primary">Nova saída</a>
        <a asp-action="Ajuste" class="btn btn-outline-primary">Ajuste manual</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Nenhuma movimentação registrada até o momento.</div>
}
else
{
    <div class="table-responsive" tabindex="0" role="region" aria-label="Histórico de movimentações">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th scope="col">Data/Hora</th>
                    <th scope="col">Produto</th>
                    <th scope="col">Numeração</th>
                    <th scope="col">Tipo</th>
                    <th scope="col">Quantidade</th>
                    <th scope="col">Responsável</th>
                    <th scope="col">Motivo / Observação</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td class="fw-bold">@item.Sku?.Produto?.Nome</td>
                        <td><span class="badge bg-light text-dark border">@item.Sku?.Numeracao</span></td>
                        <td>
                            @switch (item.Tipo)
                            {
                                case SquadEstoque.Web.Models.TipoMovimentacao.ENTRADA:
                                    <span class="badge bg-light text-dark border">ENTRADA</span>
                                    break;
                                case SquadEstoque.Web.Models.TipoMovimentacao.SAIDA:
                                    <span class="badge bg-light text-dark border">SAÍDA</span>
                                    break;
                                case SquadEstoque.Web.Models.TipoMovimentacao.AJUSTE:
                                    <span class="badge bg-light text-dark border">AJUSTE</span>
                                    break;
                            }
                        </td>
                        <td class="fw-bold">@item.Quantidade</td>
                        <td>@item.Usuario?.Nome</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Motivo))
                            {
                                <span>@item.Motivo</span>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
