@model SquadEstoque.Web.Models.AjusteEstoqueViewModel

@{
    ViewData["Title"] = "Ajuste Manual de Estoque";
}

<header class="admin-page-heading admin-form-heading movement-form-heading">
    <div>
        <h1>Ajuste manual de estoque</h1>
        <p class="admin-page-intro">Informe o saldo apurado na loja e a justificativa do ajuste.</p>
    </div>
</header>

<div class="movement-form-layout">
    <section class="movement-form-surface" aria-label="Formulário de ajuste manual de estoque">
        <form asp-action="Ajuste" method="post" class="movement-form">
                    <div asp-validation-summary="ModelOnly" class="movement-validation-summary" role="alert"></div>

                    @if (Model.SkuId != Guid.Empty && !string.IsNullOrEmpty(Model.ProdutoNome))
                    {
                        <input type="hidden" asp-for="SkuId" />
                        <div class="movement-context movement-context--adjustment">
                            <p class="movement-context-label">Item selecionado</p>
                            <p class="movement-context-product">@Model.ProdutoNome</p>
                            <div class="movement-context-details">
                                <span><strong>Numeração</strong> <span class="movement-size-chip">@Model.Numeracao</span></span>
                                <span class="movement-context-balance"><strong>Saldo atual</strong> @Model.SaldoAtual par(es)</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="movement-field">
                            <label asp-for="SkuId" class="form-label">Selecione o Produto e Numeração</label>
                            <select asp-for="SkuId" asp-items="ViewBag.SkusList" class="form-select movement-select" autofocus>
                                <option value="">-- Selecione o item --</option>
                            </select>
                            <span asp-validation-for="SkuId" class="movement-validation"></span>
                        </div>
                    }

                    <div class="movement-field">
                        <label asp-for="NovoSaldoApurado" class="form-label">Novo Saldo Real em Loja (Recontagem Físico)</label>
                        <input asp-for="NovoSaldoApurado" type="number" min="0" class="form-control movement-input movement-input--quantity" />
                        <div class="movement-field-help">Informe a quantidade exata encontrada fisicamente em loja.</div>
                        <span asp-validation-for="NovoSaldoApurado" class="movement-validation"></span>
                    </div>

                    <div class="movement-field movement-field--last">
                        <label asp-for="Motivo" class="form-label">Justificativa do Ajuste (Obrigatório, mín. 5 caracteres)</label>
                        <textarea asp-for="Motivo" rows="3" class="form-control movement-input movement-textarea" placeholder="ex: Recontagem de inventário mensal / Par avariado descartado"></textarea>
                        <span asp-validation-for="Motivo" class="movement-validation"></span>
                    </div>

                    <div class="movement-form-actions">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Salvar ajuste</button>
                    </div>
                </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
