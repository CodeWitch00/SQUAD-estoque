@model SquadEstoque.Web.Models.AjusteEstoqueViewModel

@{
    ViewData["Title"] = "Ajuste Manual de Estoque";
}

<header class="admin-page-heading admin-form-heading mb-4">
    <div>
        <h1>Ajuste manual de estoque</h1>
        <p class="admin-page-intro">Informe o saldo apurado na loja e a justificativa do ajuste.</p>
    </div>
</header>

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-9 col-xl-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Ajuste" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    @if (Model.SkuId != Guid.Empty && !string.IsNullOrEmpty(Model.ProdutoNome))
                    {
                        <input type="hidden" asp-for="SkuId" />
                        <div class="alert alert-light border mb-3">
                            <div><strong>Modelo:</strong> @Model.ProdutoNome</div>
                            <div><strong>Numeração:</strong> <span class="badge bg-secondary">@Model.Numeracao</span></div>
                            <div class="mt-1"><strong>Saldo Anterior no Sistema:</strong> <span class="fw-bold">@Model.SaldoAtual par(es)</span></div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label asp-for="SkuId" class="form-label">Selecione o Produto e Numeração</label>
                            <select asp-for="SkuId" asp-items="ViewBag.SkusList" class="form-select" autofocus>
                                <option value="">-- Selecione o item --</option>
                            </select>
                            <span asp-validation-for="SkuId" class="text-danger small"></span>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="NovoSaldoApurado" class="form-label">Novo Saldo Real em Loja (Recontagem Físico)</label>
                        <input asp-for="NovoSaldoApurado" type="number" min="0" class="form-control form-control-lg" />
                        <div class="form-text">Informe a quantidade exata encontrada fisicamente em loja.</div>
                        <span asp-validation-for="NovoSaldoApurado" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Motivo" class="form-label">Justificativa do Ajuste (Obrigatório, mín. 5 caracteres)</label>
                        <textarea asp-for="Motivo" rows="3" class="form-control" placeholder="ex: Recontagem de inventário mensal / Par avariado descartado"></textarea>
                        <span asp-validation-for="Motivo" class="text-danger small"></span>
                    </div>

                    <div class="admin-form-actions">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Salvar ajuste</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
