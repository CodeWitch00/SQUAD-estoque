@model SquadEstoque.Web.Models.Produto

@{
    ViewData["Title"] = "Detalhes do Produto";
}

<a asp-action="Index" class="details-back-link">← Voltar para produtos</a>

<header class="admin-page-heading product-details-heading">
    <div>
        <p class="product-details-kicker">Detalhes do produto</p>
        <h1>@Model.Nome</h1>
        <p class="product-details-meta">@Model.Marca <span aria-hidden="true">·</span> @Model.Categoria <span aria-hidden="true">·</span> @Model.Cor</p>
    </div>
    <div class="product-details-heading-side">
        @if (User.IsInRole("LOJISTA") && Model.Ativo)
        {
            <a asp-controller="Movimentacoes" asp-action="EntradaLote" asp-route-produtoId="@Model.Id" class="btn product-details-batch-entry">Entrada em lote</a>
        }
        <span class="badge product-status @(Model.Ativo ? "product-status-active" : "product-status-inactive")">@(Model.Ativo ? "Ativo" : "Inativo")</span>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary product-details-edit">Editar produto</a>
    </div>
</header>

<section class="product-details-surface" aria-labelledby="product-grade-title">
    <div class="product-details-section-heading">
        <div>
            <h2 id="product-grade-title">Grade de numerações</h2>
            <p>Consulte o saldo e o estado de cada SKU.</p>
        </div>
        @if (User.IsInRole("LOJISTA") && Model.Ativo)
        {
            <a asp-controller="Produtos" asp-action="AdicionarNumeracoes" asp-route-id="@Model.Id" class="btn btn-outline-primary product-details-grade-action">Adicionar numeração</a>
        }
    </div>

    <div class="table-responsive product-details-table-shell" tabindex="0" role="region" aria-label="Grade de numerações e saldos">
        <table class="table align-middle product-details-table">
            <thead>
                    <tr>
                        <th scope="col">Numeração</th>
                        <th scope="col">Saldo atual</th>
                        <th scope="col">Estado</th>
                        <th scope="col" class="text-end">Ações de estoque</th>
                    </tr>
            </thead>
            <tbody>
                @foreach (var sku in Model.Skus.OrderBy(s => s.Numeracao))
                {
                    <tr>
                        <td class="product-details-size">@sku.Numeracao</td>
                        <td class="product-details-balance">@sku.SaldoAtual par(es)</td>
                        <td>
                            @if (sku.SaldoAtual > 1)
                            {
                                <span class="badge product-details-status product-details-status--available">Disponível</span>
                            }
                            else if (sku.SaldoAtual == 1)
                            {
                                <span class="badge product-details-status product-details-status--last">Último par</span>
                            }
                            else
                            {
                                <span class="badge product-details-status product-details-status--empty">Indisponível</span>
                            }
                        </td>
                        <td>
                            <div class="admin-row-actions product-details-actions">
                                @if (User.IsInRole("LOJISTA"))
                                {
                                    <a asp-controller="Movimentacoes" asp-action="Entrada" asp-route-skuId="@sku.Id" class="btn btn-sm product-details-action product-details-action--entry">Entrada</a>
                                    <a asp-controller="Movimentacoes" asp-action="Saida" asp-route-skuId="@sku.Id" class="btn btn-sm product-details-action product-details-action--exit">Saída</a>
                                    <a asp-controller="Movimentacoes" asp-action="Ajuste" asp-route-skuId="@sku.Id" class="btn btn-sm product-details-action product-details-action--adjust">Ajuste</a>
                                }
                                else if (User.IsInRole("VENDEDOR"))
                                {
                                    <a asp-controller="Movimentacoes" asp-action="Saida" asp-route-skuId="@sku.Id" class="btn btn-sm product-details-action product-details-action--exit">Saída</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
