@model SquadEstoque.Web.Models.ProdutoEditViewModel

@{
    ViewData["Title"] = "Editar Produto";
}

<header class="admin-page-heading admin-form-heading product-form-heading">
    <div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link px-0 mb-2">← Voltar ao produto</a>
        <h1>Editar produto</h1>
        <p class="admin-page-intro">Atualize os dados do modelo cadastrado.</p>
    </div>
</header>

<div class="admin-form-layout">
    <section class="admin-form-surface" aria-label="Formulário de edição de produto">
        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="admin-form">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" autofocus />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Marca" class="form-label"></label>
                            <input asp-for="Marca" class="form-control" />
                            <span asp-validation-for="Marca" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Categoria" class="form-label"></label>
                            <input asp-for="Categoria" class="form-control" />
                            <span asp-validation-for="Categoria" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Cor" class="form-label"></label>
                        <input asp-for="Cor" class="form-control" />
                        <span asp-validation-for="Cor" class="text-danger small"></span>
                    </div>

                    <fieldset class="produto-form-secao">
                        <legend>Foto do modelo</legend>
                        @if (!string.IsNullOrWhiteSpace(Model.ImagemAtualUrl))
                        {
                            <img class="produto-foto-preview" src="@Model.ImagemAtualUrl" alt="Foto atual de @Model.Nome" />
                            <div class="form-check my-2">
                                <input asp-for="RemoverImagem" class="form-check-input" />
                                <label asp-for="RemoverImagem" class="form-check-label">Remover foto atual</label>
                            </div>
                        }
                        <label asp-for="Imagem" class="form-label">Trocar foto (opcional)</label>
                        <input asp-for="Imagem" class="form-control form-control-lg" type="file" accept="image/jpeg,image/png,image/webp" aria-describedby="foto-edicao-ajuda" data-preview-input="foto-produto-preview" />
                        <span asp-validation-for="Imagem" class="text-danger small"></span>
                        <div id="foto-edicao-ajuda" class="form-text">No celular, abra o seletor para tirar uma foto ou escolher da galeria. JPG, PNG ou WebP · até 2 MB.</div>
                        <img id="foto-produto-preview" class="produto-foto-preview" alt="Prévia da nova foto" hidden />
                    </fieldset>

                    <div class="admin-form-actions">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Salvar Alterações</button>
                    </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/produto-form.js" asp-append-version="true"></script>
}
