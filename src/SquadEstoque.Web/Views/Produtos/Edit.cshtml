@model SquadEstoque.Web.Models.ProdutoEditViewModel

@{
    ViewData["Title"] = "Editar Produto";
}

<header class="admin-page-heading admin-form-heading product-form-heading">
    <div>
        <h1>Editar produto</h1>
        <p class="admin-page-intro">Atualize os dados do modelo cadastrado.</p>
    </div>
</header>

<div class="admin-form-layout">
    <section class="admin-form-surface" aria-label="Formulário de edição de produto">
        <form asp-action="Edit" method="post" class="admin-form">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" autofocus />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Marca" class="form-label"></label>
                            <input asp-for="Marca" class="form-control" />
                            <span asp-validation-for="Marca" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Categoria" class="form-label"></label>
                            <input asp-for="Categoria" class="form-control" />
                            <span asp-validation-for="Categoria" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Cor" class="form-label"></label>
                        <input asp-for="Cor" class="form-control" />
                        <span asp-validation-for="Cor" class="text-danger small"></span>
                    </div>

                    <div class="admin-form-actions">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Salvar Alterações</button>
                    </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
