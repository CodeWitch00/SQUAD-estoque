@model IEnumerable<SquadEstoque.Web.Models.Produto>

@{
    ViewData["Title"] = "Catálogo de Produtos";
}

<div class="admin-page-heading mb-4">
    <div>
        <h1>Catálogo de Produtos</h1>
        <p class="admin-page-intro">Consulte os modelos, as numerações e o estado de cada produto.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Novo produto com grade</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Nenhum produto cadastrado no momento.</div>
}
else
{
    <div class="table-responsive" tabindex="0" role="region" aria-label="Catálogo de produtos">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th scope="col">Modelo</th>
                    <th scope="col">Marca</th>
                    <th scope="col">Categoria</th>
                    <th scope="col">Cor</th>
                    <th scope="col">Grade (Tamanhos)</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(!item.Ativo ? "text-muted opacity-75" : "")">
                        <td class="fw-bold">@item.Nome</td>
                        <td>@item.Marca</td>
                        <td>@item.Categoria</td>
                        <td>@item.Cor</td>
                        <td>
                            @foreach (var sku in item.Skus.OrderBy(s => s.Numeracao))
                            {
                                <span class="badge bg-light text-dark border me-1">@sku.Numeracao</span>
                            }
                        </td>
                        <td>
                            @if (item.Ativo)
                            {
                                <span class="badge bg-success">Ativo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inativo</span>
                            }
                        </td>
                        <td>
                            <div class="admin-row-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">Detalhes</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Editar</a>
                            <form asp-action="ToggleAtivo" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-secondary btn-sm">
                                    @(item.Ativo ? "Desativar" : "Ativar")
                                </button>
                            </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
