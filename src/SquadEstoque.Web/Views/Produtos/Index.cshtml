@model IEnumerable<SquadEstoque.Web.Models.Produto>

@{
    ViewData["Title"] = "Catálogo de Produtos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Catálogo de Produtos</h2>
    <a asp-action="Create" class="btn btn-primary">+ Novo Produto com Grade</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Nenhum produto cadastrado no momento.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Modelo</th>
                    <th>Marca</th>
                    <th>Categoria</th>
                    <th>Cor</th>
                    <th>Grade (Tamanhos)</th>
                    <th>Status</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(!item.Ativo ? "text-muted opacity-75" : "")">
                        <td class="fw-bold">@item.Nome</td>
                        <td>@item.Marca</td>
                        <td>@item.Categoria</td>
                        <td>@item.Cor</td>
                        <td>
                            @foreach (var sku in item.Skus.OrderBy(s => s.Numeracao))
                            {
                                <span class="badge bg-light text-dark border me-1">@sku.Numeracao</span>
                            }
                        </td>
                        <td>
                            @if (item.Ativo)
                            {
                                <span class="badge bg-success">Ativo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inativo</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm me-1">Detalhes</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm me-1">Editar</a>
                            <form asp-action="ToggleAtivo" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn @(item.Ativo ? "btn-outline-warning" : "btn-outline-success") btn-sm">
                                    @(item.Ativo ? "Desativar" : "Ativar")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
