@model IReadOnlyList<EntradaFiscal>
@{
    ViewData["Title"] = "Entradas por NF-e";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <a asp-controller="Produtos" asp-action="Create" class="btn btn-link px-0 mb-2">← Voltar ao cadastro de produto</a>
        <h1 class="mb-1">Entradas por NF-e</h1>
        <p class="text-muted mb-0">Importe o XML, confira os itens e confirme a atualização do estoque.</p>
    </div>
    <a class="btn btn-primary" asp-action="Importar">Importar XML</a>
</div>

@if (TempData["MensagemSucesso"] is string mensagem)
{
    <div class="alert alert-success" role="status">@mensagem</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-light border">Nenhuma NF-e importada.</div>
}
else
{
    <div class="table-responsive admin-mobile-cards" tabindex="0" role="region" aria-label="Entradas por NF-e">
        <table class="table align-middle admin-mobile-cards-table">
            <thead><tr><th scope="col">NF-e</th><th scope="col">Fornecedor</th><th scope="col">Itens</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Ações</span></th></tr></thead>
            <tbody>
            @foreach (var entrada in Model)
            {
                <tr>
                    <td data-label="NF-e"><strong>@entrada.Numero</strong><br /><small class="text-muted">@entrada.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></td>
                    <td data-label="Fornecedor">@entrada.FornecedorNome<br /><small class="text-muted">@entrada.CnpjFornecedor</small></td>
                    <td data-label="Itens">@entrada.Itens.Count</td>
                    <td data-label="Status"><span class="badge @(entrada.Status == StatusEntradaFiscal.CONFIRMADA ? "text-bg-success" : "text-bg-warning")">@entrada.Status</span></td>
                    <td data-label="Ações" class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Conferir" asp-route-id="@entrada.Id">
                            @(entrada.Status == StatusEntradaFiscal.RASCUNHO ? "Continuar" : "Ver")
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
