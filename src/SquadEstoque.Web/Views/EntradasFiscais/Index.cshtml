@model IReadOnlyList<EntradaFiscal>
@{
    ViewData["Title"] = "Entradas por NF-e";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <a asp-controller="Produtos" asp-action="Create" class="btn btn-link px-0 mb-2">← Voltar ao cadastro de produto</a>
        <h1 class="mb-1">Entradas por NF-e</h1>
        <p class="text-muted mb-0">Importe o XML, confira os itens e confirme a atualização do estoque.</p>
    </div>
    <a class="btn btn-primary" asp-action="Importar">Importar XML</a>
</div>

@if (TempData["MensagemSucesso"] is string mensagem)
{
    <div class="alert alert-success" role="status">@mensagem</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-light border">Nenhuma NF-e importada.</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>NF-e</th><th>Fornecedor</th><th>Itens</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var entrada in Model)
            {
                <tr>
                    <td><strong>@entrada.Numero</strong><br /><small class="text-muted">@entrada.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></td>
                    <td>@entrada.FornecedorNome<br /><small class="text-muted">@entrada.CnpjFornecedor</small></td>
                    <td>@entrada.Itens.Count</td>
                    <td><span class="badge @(entrada.Status == StatusEntradaFiscal.CONFIRMADA ? "text-bg-success" : "text-bg-warning")">@entrada.Status</span></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Conferir" asp-route-id="@entrada.Id">
                            @(entrada.Status == StatusEntradaFiscal.RASCUNHO ? "Continuar" : "Ver")
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
