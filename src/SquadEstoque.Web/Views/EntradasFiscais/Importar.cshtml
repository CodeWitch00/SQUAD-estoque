@model ImportarEntradaFiscalViewModel
@{
    ViewData["Title"] = "Importar NF-e";
}

<div class="entrada-fiscal-pagina">
    <a asp-controller="Produtos" asp-action="Create" class="btn btn-link px-0 mb-3">← Voltar ao cadastro de produto</a>
    <h1>Importar produtos da NF-e</h1>
    <p class="text-muted">O estoque não será alterado até a conferência ser confirmada.</p>

    <form asp-action="Importar" method="post" enctype="multipart/form-data" class="card entrada-fiscal-upload">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <label asp-for="ArquivoXml" class="form-label fw-semibold"></label>
            <input asp-for="ArquivoXml" class="form-control form-control-lg" type="file" accept=".xml,application/xml,text/xml" />
            <span asp-validation-for="ArquivoXml" class="text-danger"></span>
            <p class="form-text mb-0">Selecione o XML autorizado da nota (até 5 MB). PDF e DANFE não são aceitos nesta etapa. O estoque só muda depois da conferência e confirmação.</p>
        </div>
        <div class="card-footer bg-white border-0 pt-0">
            <a asp-controller="Produtos" asp-action="Create" class="btn btn-outline-secondary btn-lg me-2">Voltar</a>
            <button class="btn btn-primary btn-lg" type="submit">Ler NF-e</button>
        </div>
    </form>
</div>
