@{
    var vendedor = User.IsInRole("VENDEDOR");
    var lojista = User.IsInRole("LOJISTA");
    var autenticado = User.Identity?.IsAuthenticated == true;
    var inicioController = vendedor ? "Estoque" : lojista ? "Produtos" : "Account";
    var inicioAction = vendedor ? "Consulta" : lojista ? "Index" : "Login";
    var controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SQUAD Estoque</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SquadEstoque.Web.styles.css" asp-append-version="true" />
</head>
<body class="@(vendedor ? "seller-layout" : "admin-layout")">
    <header>
        <nav class="navbar navbar-expand-lg squad-navbar" aria-label="Navegação principal">
            <div class="container-fluid squad-navbar-inner">
                <a class="navbar-brand squad-brand" asp-controller="@inicioController" asp-action="@inicioAction" aria-label="SQUAD Estoque: início">
                    <img src="~/images/logo-squad-header.png" alt="" width="128" height="96" />
                </a>
                @if (autenticado)
                {
                    <button class="navbar-toggler squad-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#squad-navigation"
                            aria-controls="squad-navigation" aria-expanded="false" aria-label="Alternar navegação">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                }
                <div id="squad-navigation" class="@(autenticado ? "collapse navbar-collapse" : "navbar-collapse")">
                    <ul class="navbar-nav me-auto squad-links">
                        @if (lojista)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controllerAtual == "Produtos" ? "active" : "")" asp-controller="Produtos" asp-action="Index"
                                   aria-current="@(controllerAtual == "Produtos" ? "page" : null)">Produtos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(controllerAtual == "Movimentacoes" ? "active" : "")" asp-controller="Movimentacoes" asp-action="Index"
                                   aria-current="@(controllerAtual == "Movimentacoes" ? "page" : null)">Movimentações</a>
                            </li>
                        }
                    </ul>
                    <div class="squad-session">
                        @if (autenticado)
                        {
                            <span class="squad-role">@(vendedor ? "VENDEDOR" : lojista ? "LOJISTA" : "USUÁRIO")</span>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="squad-logout">Sair</button>
                            </form>
                        }
                        else
                        {
                            <a class="squad-login" asp-controller="Account" asp-action="Login">Entrar</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="@(vendedor ? "seller-main" : "admin-main")">
        <main role="main" class="pb-3 @(vendedor ? "" : "admin-content")">
            @RenderBody()
        </main>
    </div>
    @if (!vendedor)
    {
        <footer class="admin-footer">
            <div class="admin-footer-inner">&copy; 2026 - SQUAD Estoque</div>
        </footer>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
