@{
    var usuarioVendedor = User.IsInRole("VENDEDOR");
    var inicioController = usuarioVendedor
        ? "Estoque"
        : User.IsInRole("LOJISTA")
            ? "Produtos"
            : "Account";
    var inicioAction = usuarioVendedor
        ? "Consulta"
        : User.IsInRole("LOJISTA")
            ? "Index"
            : "Login";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SQUAD Estoque</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SquadEstoque.Web.styles.css" asp-append-version="true" />
</head>
<body class="@(usuarioVendedor ? "seller-layout" : "admin-layout")">
    <header>
        @if (usuarioVendedor)
        {
            <nav class="seller-navbar" aria-label="Navegação do vendedor">
                <div class="seller-navbar-inner">
                    <a class="seller-brand" asp-controller="Estoque" asp-action="Consulta">
                        <span class="seller-brand-mark" aria-hidden="true">SQ</span>
                        <span>SQUAD Estoque</span>
                    </a>
                    <div class="seller-navbar-actions">
                        <a class="seller-nav-link" asp-controller="Estoque" asp-action="Consulta" aria-current="page">Consulta</a>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="seller-logout">Sair</button>
                        </form>
                    </div>
                </div>
            </nav>
        }
        else
        {
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-controller="@inicioController" asp-action="@inicioAction">SQUAD Estoque</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Alternar navegação">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            @if (User.IsInRole("LOJISTA"))
                            {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-bold" asp-controller="Produtos" asp-action="Index">Produtos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-bold" asp-controller="Movimentacoes" asp-action="Index">Movimentações</a>
                            </li>
                            }
                        </ul>
                        <ul class="navbar-nav">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                            <li class="nav-item d-flex align-items-center me-3">
                                <span class="text-dark me-2">@User.Identity.Name</span>
                                <span class="badge bg-secondary">LOJISTA</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Sair</button>
                                </form>
                            </li>
                            }
                            else
                            {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Entrar</a>
                            </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        }
    </header>
    <div class="@(usuarioVendedor ? "seller-main" : "container")">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @if (!usuarioVendedor)
    {
        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2026 - SQUAD Estoque
            </div>
        </footer>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
