@{
    var vendedor = User.IsInRole("VENDEDOR");
    var lojista = User.IsInRole("LOJISTA");
    var autenticado = User.Identity?.IsAuthenticated == true;
    var inicioController = vendedor ? "Estoque" : lojista ? "Produtos" : "Account";
    var inicioAction = vendedor ? "Consulta" : lojista ? "Index" : "Login";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SQUAD Estoque</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SquadEstoque.Web.styles.css" asp-append-version="true" />
</head>
<body class="@(vendedor ? "seller-layout" : lojista ? "admin-layout" : "public-layout")">
    @if (lojista)
    {
        <div class="admin-shell">
            <aside class="offcanvas offcanvas-lg offcanvas-start squad-sidebar" tabindex="-1" id="squad-admin-navigation"
                   aria-label="Navegação do lojista" data-bs-backdrop="true">
                <div class="offcanvas-header squad-sidebar-header">
                    <a class="squad-sidebar-brand" asp-controller="Produtos" asp-action="Index" aria-label="SQUAD Estoque: produtos">
                        <img src="~/images/logo-squad-header.png" alt="SQUAD Controle de Estoque" width="176" height="132" />
                    </a>
                    <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas"
                            aria-label="Fechar navegação"></button>
                </div>
                <div class="offcanvas-body squad-sidebar-body">
                    <partial name="_AdminNavigation" />
                    <div class="squad-sidebar-session">
                        <span class="squad-role">LOJISTA</span>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="squad-sidebar-logout">Sair da conta</button>
                        </form>
                    </div>
                </div>
            </aside>

            <div class="admin-column">
                <header class="admin-mobile-header">
                    <button class="admin-menu-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#squad-admin-navigation"
                            aria-controls="squad-admin-navigation" aria-label="Abrir menu administrativo">
                        <span aria-hidden="true">☰</span>
                        <span>Menu</span>
                    </button>
                    <a class="admin-mobile-brand" asp-controller="Produtos" asp-action="Index" aria-label="SQUAD Estoque: produtos">
                        <img src="~/images/logo-squad-header.png" alt="SQUAD" width="96" height="72" />
                    </a>
                </header>
                <main role="main" class="admin-main admin-content">
                    @RenderBody()
                </main>
                <footer class="admin-footer"><div class="admin-footer-inner">&copy; 2026 - SQUAD Estoque</div></footer>
            </div>
        </div>
    }
    else
    {
        <header class="seller-header">
            <div class="seller-header-inner">
                <a class="seller-brand" asp-controller="@inicioController" asp-action="@inicioAction" aria-label="SQUAD Estoque: início">
                    <img src="~/images/logo-squad-header.png" alt="SQUAD Estoque" width="112" height="84" />
                </a>
                <div class="seller-session">
                    @if (autenticado)
                    {
                        <span class="squad-role">VENDEDOR</span>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="squad-logout">Sair</button>
                        </form>
                    }
                    else
                    {
                        <a class="squad-login" asp-controller="Account" asp-action="Login">Entrar</a>
                    }
                </div>
            </div>
        </header>
        <div class="seller-main">
            <main role="main" class="pb-3">@RenderBody()</main>
        </div>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
