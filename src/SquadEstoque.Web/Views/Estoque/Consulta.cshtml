@model SquadEstoque.Web.Models.ConsultaEstoqueViewModel

@{
    ViewData["Title"] = "Consulta de Estoque";
}

<h1 class="h3">Consulta de estoque</h1>
<form method="get" class="row g-2 mb-4">
    <div class="col-sm-8"><input asp-for="Termo" class="form-control" placeholder="Nome do produto" /></div>
    <div class="col-sm-4"><button class="btn btn-primary" type="submit">Consultar</button></div>
</form>

@if (Model.MensagemEstado is not null)
{
    <div class="alert alert-info">@Model.MensagemEstado</div>
}

@foreach (var produto in Model.Resultados)
{
    <a asp-action="Detalhes" asp-route-id="@produto.Id" class="card card-body mb-2 text-decoration-none text-dark">
        <strong>@produto.Nome</strong>
        <span>@produto.Marca · @produto.Categoria · @produto.Cor</span>
    </a>
}
