@model SquadEstoque.Web.Models.SaldosZeradosViewModel

@{
    ViewData["Title"] = "Saldos zerados para reposição";
}

<div class="report-page">
<div class="admin-page-heading mb-4">
    <div>
        <h1>Saldos zerados para reposição</h1>
        <p class="admin-page-intro">Numerações sem saldo, agrupadas por produto, para apoiar a reposição.</p>
    </div>
</div>

@if (Model.Produtos.Count == 0)
{
    <div class="alert alert-info" role="status">Nenhum produto possui numerações com saldo zerado no momento.</div>
}
else
{
    <p class="text-secondary">Produtos em ordem de nome, com suas numerações sem saldo.</p>
    <div class="row g-3">
        @foreach (var produto in Model.Produtos)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <section class="card h-100" aria-labelledby="produto-@produto.Id">
                    <div class="card-body">
                        <h2 id="produto-@produto.Id" class="h5 card-title">@produto.Nome</h2>
                        <p class="text-secondary mb-2">@produto.Marca · @produto.Cor</p>
                        <p class="mb-2">Numerações sem saldo:</p>
                        <ul class="list-unstyled mb-0">
                            @foreach (var sku in produto.NumeracoesZeradas)
                            {
                                <li class="saldos-zerados-sku">
                                    <span class="badge text-bg-secondary text-wrap">@sku.Numeracao</span>
                                    <small class="sku-last-update">
                                        @if (sku.UltimaAtualizacaoSaldoEm.HasValue)
                                        {
                                            var atualizacaoLocal = sku.UltimaAtualizacaoSaldoEm.Value.ToLocalTime();
                                            <span>Atualizado em <time datetime="@atualizacaoLocal.ToString("O")">@atualizacaoLocal.ToString("dd/MM/yyyy HH:mm")</time></span>
                                        }
                                        else
                                        {
                                            <span>Atualização não registrada</span>
                                        }
                                    </small>
                                </li>
                            }
                        </ul>
                    </div>
                </section>
            </div>
        }
    </div>
}

</div>
