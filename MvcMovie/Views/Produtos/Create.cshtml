@model MvcMovie.Models.ProdutoCreateViewModel

@{
    ViewData["Title"] = "Novo Produto";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="card-title mb-4">Cadastrar Produto e Grade</h3>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" placeholder="ex: Tênis Casual Run" autofocus />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Marca" class="form-label"></label>
                            <input asp-for="Marca" class="form-control" placeholder="ex: Olympikus" />
                            <span asp-validation-for="Marca" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Categoria" class="form-label"></label>
                            <input asp-for="Categoria" class="form-control" placeholder="ex: Tênis" />
                            <span asp-validation-for="Categoria" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Cor" class="form-label"></label>
                        <input asp-for="Cor" class="form-control" placeholder="ex: Preto/Cinza" />
                        <span asp-validation-for="Cor" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="NumeracoesGrade" class="form-label"></label>
                        <input asp-for="NumeracoesGrade" class="form-control" placeholder="ex: 37, 38, 39, 40, 41" />
                        <div class="form-text">Informe as numerações da grade separadas por vírgula. O sistema gerará os SKUs automaticamente com saldo 0.</div>
                        <span asp-validation-for="NumeracoesGrade" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Salvar Produto e Grade</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
